<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#090909">

<title>Tisay AI — Character Archive</title>

<meta
    name="description"
    content="Original AI characters, interactive stories and worlds by Tisay AI."
>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<style>
/* =========================================================
   TISAY AI — CHARACTER ARCHIVE
   Mobile-first / GitHub Pages / No dependencies
========================================================= */

:root {
    --bg: #080808;
    --bg-soft: #0d0d0d;
    --surface: #111111;
    --surface-2: #171717;
    --surface-3: #1d1d1d;

    --text: #f2eee7;
    --muted: #98938c;
    --muted-light: #c4bdb4;

    --gold: #cbb99b;
    --gold-bright: #ead8b8;
    --gold-dark: #796b56;

    --border: rgba(203,185,155,.18);
    --border-bright: rgba(203,185,155,.45);

    --shadow: 0 20px 60px rgba(0,0,0,.5);
    --glow: 0 0 25px rgba(203,185,155,.12);

    --radius: 18px;
    --nav-height: 70px;

    --serif: "Cormorant Garamond", Georgia, serif;
    --sans: "Inter", Arial, sans-serif;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    background:
        radial-gradient(circle at 50% -10%, rgba(203,185,155,.08), transparent 35%),
        var(--bg);
    color: var(--text);
    font-family: var(--sans);
    min-height: 100vh;
    overflow-x: hidden;
}

body.modal-open {
    overflow: hidden;
}

button,
input,
select {
    font: inherit;
}

button,
a {
    -webkit-tap-highlight-color: transparent;
}

button {
    color: inherit;
}

a {
    color: inherit;
    text-decoration: none;
}

img {
    display: block;
    max-width: 100%;
}

/* =========================================================
   BACKGROUND FX
========================================================= */

.grain {
    position: fixed;
    inset: 0;
    z-index: 1000;
    pointer-events: none;
    opacity: .22;

    background-image:
        url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.10'/%3E%3C/svg%3E");
}

.vignette {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 999;
    box-shadow: inset 0 0 160px rgba(0,0,0,.75);
}

/* =========================================================
   HEADER
========================================================= */

.site-header {
    height: 66px;
    position: sticky;
    top: 0;
    z-index: 500;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 18px;

    background: rgba(8,8,8,.78);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);

    border-bottom: 1px solid var(--border);
}

.brand {
    display: flex;
    align-items: center;
    gap: 10px;
}

.brand-mark {
    color: var(--gold);
    font-size: 1.3rem;
}

.brand-name {
    font-family: var(--serif);
    font-weight: 700;
    letter-spacing: .13em;
    font-size: 1.2rem;
}

.brand-name span {
    color: var(--gold);
}

.header-link {
    font-size: .72rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--muted-light);
}

/* =========================================================
   HERO
========================================================= */

.hero {
    min-height: 460px;
    height: 66svh;
    max-height: 720px;

    position: relative;
    overflow: hidden;

    display: flex;
    align-items: flex-end;

    border-bottom: 1px solid var(--border);
}

.hero-bg {
    position: absolute;
    inset: 0;

    background:
        linear-gradient(to bottom, rgba(0,0,0,.05), rgba(8,8,8,.2) 45%, var(--bg) 100%),
        radial-gradient(circle at 70% 30%, rgba(203,185,155,.12), transparent 35%),
        linear-gradient(135deg, #1c1b19, #080808 60%);
}

.hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: .72;
}

.hero-bg::after {
    content: "";
    position: absolute;
    inset: 12px;
    border: 1px solid rgba(203,185,155,.25);
    pointer-events: none;
}

.hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding: 30px 22px 46px;
}

.eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;

    color: var(--gold);
    font-size: .67rem;
    font-weight: 600;
    letter-spacing: .22em;
    text-transform: uppercase;

    margin-bottom: 12px;
}

.eyebrow::before {
    content: "";
    width: 30px;
    height: 1px;
    background: var(--gold);
}

.hero h1 {
    font-family: var(--serif);
    text-transform: uppercase;
    font-size: clamp(3rem, 15vw, 7rem);
    line-height: .78;
    letter-spacing: .01em;
    font-weight: 600;
}

.hero h1 span {
    color: var(--gold);
    display: block;
}

.hero-description {
    max-width: 550px;
    margin-top: 20px;
    color: var(--muted-light);
    font-family: var(--serif);
    font-size: 1.2rem;
    font-style: italic;
    line-height: 1.45;
}

/* =========================================================
   MAIN
========================================================= */

main {
    padding-bottom: calc(var(--nav-height) + 50px);
}

.section {
    padding: 42px 16px;
    max-width: 1300px;
    margin: auto;
}

.section-heading {
    margin-bottom: 22px;
}

.section-kicker {
    color: var(--gold);
    font-size: .65rem;
    font-weight: 600;
    letter-spacing: .22em;
    text-transform: uppercase;
    margin-bottom: 6px;
}

.section-title {
    font-family: var(--serif);
    font-size: 2.15rem;
    line-height: 1;
    text-transform: uppercase;
}

.section-description {
    margin-top: 9px;
    color: var(--muted);
    font-size: .88rem;
    line-height: 1.65;
    max-width: 620px;
}

/* =========================================================
   STATS
========================================================= */

.stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--border);
    background: var(--surface);
    margin-top: -1px;
}

.stat {
    padding: 18px 8px;
    text-align: center;
}

.stat + .stat {
    border-left: 1px solid var(--border);
}

.stat-number {
    display: block;
    color: var(--gold);
    font-family: var(--serif);
    font-size: 1.8rem;
    line-height: 1;
}

.stat-label {
    display: block;
    margin-top: 5px;
    color: var(--muted);
    font-size: .58rem;
    letter-spacing: .13em;
    text-transform: uppercase;
}

/* =========================================================
   FEATURED CHARACTER
========================================================= */

.featured {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
}

.featured-image {
    aspect-ratio: 4 / 5;
    position: relative;
    background: #151515;
}

.featured-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.featured-image::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 45%, rgba(0,0,0,.85));
}

.featured-badge {
    position: absolute;
    z-index: 2;
    top: 14px;
    left: 14px;

    padding: 7px 10px;

    border: 1px solid rgba(255,255,255,.25);
    background: rgba(0,0,0,.55);
    backdrop-filter: blur(10px);

    font-size: .58rem;
    letter-spacing: .18em;
    text-transform: uppercase;
}

.featured-info {
    padding: 22px;
}

.featured-name {
    color: var(--gold-bright);
    font-family: var(--serif);
    text-transform: uppercase;
    font-size: 2rem;
    line-height: 1;
}

.featured-title {
    margin-top: 5px;
    color: var(--muted);
    font-family: var(--serif);
    font-style: italic;
    font-size: 1rem;
}

.featured-desc {
    margin-top: 14px;
    color: var(--muted-light);
    font-size: .85rem;
    line-height: 1.7;
}

/* =========================================================
   SEARCH + FILTER
========================================================= */

.archive-tools {
    position: sticky;
    top: 66px;
    z-index: 50;

    padding: 12px 0;

    background: linear-gradient(
        to bottom,
        var(--bg) 75%,
        transparent
    );
}

.search-wrap {
    position: relative;
}

.search {
    width: 100%;
    height: 48px;

    border: 1px solid var(--border);
    border-radius: 12px;

    background: rgba(17,17,17,.96);
    color: var(--text);

    outline: none;

    padding: 0 15px 0 42px;
}

.search:focus {
    border-color: var(--border-bright);
    box-shadow: var(--glow);
}

.search-icon {
    position: absolute;
    left: 15px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--muted);
}

.filters {
    display: flex;
    gap: 8px;

    overflow-x: auto;
    scrollbar-width: none;

    padding: 10px 1px 3px;
}

.filters::-webkit-scrollbar {
    display: none;
}

.filter-btn {
    flex: 0 0 auto;

    border: 1px solid var(--border);
    border-radius: 999px;

    background: var(--surface);
    color: var(--muted-light);

    padding: 8px 13px;

    cursor: pointer;

    font-size: .68rem;
    letter-spacing: .08em;
    text-transform: uppercase;
}

.filter-btn.active {
    background: var(--gold);
    color: #080808;
    border-color: var(--gold);
}

/* =========================================================
   CHARACTER GRID
========================================================= */

.character-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0,1fr));
    gap: 10px;
}

.character-card {
    position: relative;
    overflow: hidden;

    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 13px;

    cursor: pointer;

    transition:
        transform .25s ease,
        border-color .25s ease,
        box-shadow .25s ease;
}

.character-card:active {
    transform: scale(.98);
}

.card-image {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background:
        radial-gradient(circle, #242424, #111);
}

.card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;

    transition: transform .6s ease;
}

.character-card:hover .card-image img {
    transform: scale(1.035);
}

.card-image::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
        linear-gradient(
            to bottom,
            transparent 50%,
            rgba(0,0,0,.75) 100%
        );
}

.card-world {
    position: absolute;
    z-index: 2;
    top: 8px;
    left: 8px;

    max-width: calc(100% - 16px);

    padding: 5px 7px;

    border: 1px solid rgba(255,255,255,.16);
    background: rgba(0,0,0,.58);
    backdrop-filter: blur(8px);

    color: #ddd;
    font-size: .48rem;
    letter-spacing: .12em;
    text-transform: uppercase;

    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.card-content {
    padding: 11px 11px 13px;
}

.card-name {
    font-family: var(--serif);
    font-size: 1.15rem;
    line-height: 1;
    color: var(--gold-bright);
    text-transform: uppercase;
}

.card-subtitle {
    color: var(--muted);
    font-size: .65rem;
    margin-top: 4px;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.card-tags {
    display: flex;
    gap: 5px;
    flex-wrap: wrap;
    margin-top: 9px;
}

.tag {
    padding: 4px 6px;
    border: 1px solid var(--border);
    border-radius: 999px;

    color: var(--muted-light);
    font-size: .52rem;
}

.empty-state {
    display: none;
    text-align: center;
    padding: 50px 20px;
    color: var(--muted);
}

/* =========================================================
   RANDOM / GACHA
========================================================= */

.summon {
    position: relative;
    overflow: hidden;

    padding: 34px 22px;

    border: 1px solid var(--border);
    border-radius: var(--radius);

    background:
        radial-gradient(circle at 50% 0%, rgba(203,185,155,.12), transparent 45%),
        var(--surface);

    text-align: center;
}

.summon-symbol {
    color: var(--gold);
    font-family: var(--serif);
    font-size: 3.2rem;
    line-height: 1;
    text-shadow: 0 0 30px rgba(203,185,155,.4);
}

.summon h3 {
    margin-top: 10px;
    font-family: var(--serif);
    font-size: 1.8rem;
    text-transform: uppercase;
}

.summon p {
    max-width: 430px;
    margin: 8px auto 20px;
    color: var(--muted);
    font-size: .82rem;
    line-height: 1.6;
}

.gold-button {
    min-height: 45px;

    border: 1px solid var(--gold);
    border-radius: 8px;

    background: var(--gold);
    color: #090909;

    padding: 0 18px;

    cursor: pointer;

    font-size: .68rem;
    font-weight: 600;
    letter-spacing: .14em;
    text-transform: uppercase;
}

/* =========================================================
   ABOUT
========================================================= */

.about-card {
    padding: 26px 20px;

    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
}

.about-card h3 {
    color: var(--gold);
    font-family: var(--serif);
    font-size: 1.8rem;
    text-transform: uppercase;
}

.about-card p {
    margin-top: 12px;
    color: var(--muted-light);
    line-height: 1.8;
    font-size: .86rem;
}

.creator-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
}

.creator-link {
    padding: 9px 12px;

    border: 1px solid var(--border);
    border-radius: 8px;

    color: var(--gold);
    font-size: .67rem;
    letter-spacing: .08em;
    text-transform: uppercase;
}

/* =========================================================
   MODAL
========================================================= */

.modal {
    position: fixed;
    inset: 0;

    z-index: 2000;

    display: flex;
    align-items: flex-end;

    background: rgba(0,0,0,.78);

    opacity: 0;
    visibility: hidden;

    transition: .3s ease;
}

.modal.open {
    opacity: 1;
    visibility: visible;
}

.modal-panel {
    width: 100%;
    max-height: 94svh;

    overflow-y: auto;

    background: var(--bg-soft);

    border: 1px solid var(--border);
    border-bottom: none;

    border-radius: 22px 22px 0 0;

    transform: translateY(40px);
    transition: .35s cubic-bezier(.2,.8,.2,1);
}

.modal.open .modal-panel {
    transform: translateY(0);
}

.modal-handle {
    width: 42px;
    height: 4px;

    margin: 9px auto;

    border-radius: 10px;

    background: #444;
}

.modal-close {
    position: absolute;
    z-index: 4;
    top: 20px;
    right: 15px;

    width: 40px;
    height: 40px;

    border: 1px solid rgba(255,255,255,.22);
    border-radius: 50%;

    background: rgba(0,0,0,.62);
    color: white;

    cursor: pointer;

    font-size: 1.1rem;
}

.modal-image {
    position: relative;
    aspect-ratio: 4 / 5;
    background: #111;
}

.modal-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.modal-image::after {
    content: "";
    position: absolute;
    inset: 0;

    background:
        linear-gradient(
            to bottom,
            transparent 55%,
            var(--bg-soft) 100%
        );
}

.modal-content {
    padding: 4px 20px 35px;
}

.modal-world {
    color: var(--gold);
    font-size: .6rem;
    letter-spacing: .18em;
    text-transform: uppercase;
}

.modal-name {
    margin-top: 6px;

    color: var(--gold-bright);

    font-family: var(--serif);
    font-size: 2.7rem;
    line-height: .9;

    text-transform: uppercase;
}

.modal-title {
    margin-top: 8px;

    color: var(--muted-light);

    font-family: var(--serif);
    font-style: italic;
    font-size: 1.1rem;
}

.modal-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;

    margin-top: 15px;
}

.meta-pill {
    padding: 6px 8px;

    border: 1px solid var(--border);
    border-radius: 999px;

    color: var(--muted-light);
    font-size: .6rem;
}

.modal-description {
    margin-top: 20px;

    color: #cbc6be;

    font-family: var(--serif);
    font-size: 1.04rem;
    line-height: 1.7;
}

.action-title {
    margin-top: 28px;
    margin-bottom: 10px;

    color: var(--muted);

    font-size: .6rem;
    letter-spacing: .18em;
    text-transform: uppercase;
}

.platform-links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
}

.platform-link {
    min-height: 46px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 1px solid var(--border);
    border-radius: 8px;

    background: var(--surface);

    color: var(--gold-bright);

    font-size: .65rem;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
}

.platform-link.primary {
    grid-column: 1 / -1;

    background: var(--gold);
    color: #090909;
    border-color: var(--gold);
}

.modal-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;

    margin-top: 8px;
}

.secondary-action {
    min-height: 43px;

    border: 1px solid var(--border);
    border-radius: 8px;

    background: transparent;

    cursor: pointer;

    color: var(--muted-light);

    font-size: .64rem;
    letter-spacing: .08em;
    text-transform: uppercase;
}

/* =========================================================
   MOBILE BOTTOM NAV
========================================================= */

.bottom-nav {
    position: fixed;
    z-index: 700;

    bottom: 0;
    left: 0;
    right: 0;

    height: var(--nav-height);

    display: grid;
    grid-template-columns: repeat(4, 1fr);

    padding-bottom: env(safe-area-inset-bottom);

    background: rgba(10,10,10,.9);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);

    border-top: 1px solid var(--border);
}

.nav-button {
    border: 0;
    background: transparent;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    gap: 3px;

    cursor: pointer;

    color: var(--muted);
}

.nav-icon {
    font-family: var(--serif);
    font-size: 1.15rem;
}

.nav-label {
    font-size: .5rem;
    letter-spacing: .08em;
    text-transform: uppercase;
}

.nav-button.active {
    color: var(--gold);
}

/* =========================================================
   DESKTOP
========================================================= */

@media (min-width: 700px) {

    .site-header {
        padding-left: 5%;
        padding-right: 5%;
    }

    .hero-content {
        padding-left: 7%;
        padding-bottom: 80px;
    }

    .section {
        padding-left: 30px;
        padding-right: 30px;
        padding-top: 70px;
    }

    .character-grid {
        grid-template-columns: repeat(3, minmax(0,1fr));
        gap: 18px;
    }

    .featured {
        display: grid;
        grid-template-columns: minmax(300px,.8fr) 1fr;
    }

    .featured-image {
        aspect-ratio: 3 / 4;
    }

    .featured-info {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 45px;
    }

    .featured-name {
        font-size: 3rem;
    }

    .modal {
        align-items: center;
        justify-content: center;
        padding: 30px;
    }

    .modal-panel {
        max-width: 900px;
        max-height: 90vh;

        border-bottom: 1px solid var(--border);
        border-radius: 20px;

        display: grid;
        grid-template-columns: .9fr 1fr;

        overflow: hidden;
    }

    .modal-handle {
        display: none;
    }

    .modal-image {
        aspect-ratio: auto;
        min-height: 650px;
    }

    .modal-image::after {
        background:
            linear-gradient(
                to right,
                transparent 65%,
                var(--bg-soft)
            );
    }

    .modal-content {
        overflow-y: auto;
        padding: 70px 38px 40px;
    }

    .bottom-nav {
        width: auto;
        left: 50%;
        right: auto;

        transform: translateX(-50%);

        bottom: 20px;

        height: 60px;

        border: 1px solid var(--border);
        border-radius: 18px;

        overflow: hidden;

        grid-template-columns: repeat(4, 90px);

        padding: 0;
    }

    main {
        padding-bottom: 120px;
    }
}

@media (min-width: 1050px) {

    .character-grid {
        grid-template-columns: repeat(4, minmax(0,1fr));
    }

    .character-card:hover {
        transform: translateY(-5px);
        border-color: var(--border-bright);
        box-shadow: var(--glow);
    }
}
</style>
</head>

<body>

<div class="grain"></div>
<div class="vignette"></div>

<header class="site-header">
    <a href="#home" class="brand">
        <span class="brand-mark">𒌐</span>
        <div class="brand-name">TISAY <span>AI</span></div>
    </a>

    <a href="https://tisayai.com" class="header-link" target="_blank" rel="noopener">
        Main Site ↗
    </a>
</header>

<main>

<!-- ======================================================
     HOME
====================================================== -->

<section class="hero" id="home">

    <div class="hero-bg" id="heroBackground"></div>

    <div class="hero-content">

        <div class="eyebrow">
            Original Characters
        </div>

        <h1>
            Tisay
            <span>AI</span>
        </h1>

        <p class="hero-description">
            Original characters, interactive stories and worlds
            crafted for roleplay, romance and long-form adventures.
        </p>

    </div>

</section>


<!-- STATS -->

<div class="stats">

    <div class="stat">
        <span class="stat-number" id="characterCount">0</span>
        <span class="stat-label">Characters</span>
    </div>

    <div class="stat">
        <span class="stat-number" id="worldCount">0</span>
        <span class="stat-label">Worlds</span>
    </div>

    <div class="stat">
        <span class="stat-number">𒌐</span>
        <span class="stat-label">Tisay AI</span>
    </div>

</div>


<!-- FEATURED -->

<section class="section" id="featuredSection">

    <div class="section-heading">

        <div class="section-kicker">
            Selected Card
        </div>

        <h2 class="section-title">
            Featured
        </h2>

    </div>

    <div id="featuredCharacter"></div>

</section>


<!-- CHARACTER ARCHIVE -->

<section class="section" id="characters">

    <div class="section-heading">

        <div class="section-kicker">
            Character Cards
        </div>

        <h2 class="section-title">
            The Archive
        </h2>

        <p class="section-description">
            Browse original Tisay AI characters and open a card
            to find downloads, lore and available chat platforms.
        </p>

    </div>


    <div class="archive-tools">

        <div class="search-wrap">

            <span class="search-icon">⌕</span>

            <input
                class="search"
                id="characterSearch"
                type="search"
                placeholder="Search characters..."
                autocomplete="off"
            >

        </div>

        <div class="filters" id="filters"></div>

    </div>


    <div
        class="character-grid"
        id="characterGrid"
    ></div>


    <div
        class="empty-state"
        id="emptyState"
    >
        No characters found.
    </div>

</section>


<!-- RANDOM -->

<section class="section" id="discover">

    <div class="section-heading">

        <div class="section-kicker">
            Fate Decides
        </div>

        <h2 class="section-title">
            Summon
        </h2>

    </div>


    <div class="summon">

        <div class="summon-symbol">
            𒌐
        </div>

        <h3>
            Draw a Character
        </h3>

        <p>
            Don't know who to meet? Draw a random card from
            the Tisay AI archive.
        </p>

        <button
            class="gold-button"
            onclick="summonRandomCharacter()"
        >
            Summon Character
        </button>

    </div>

</section>


<!-- ABOUT -->

<section class="section" id="about">

    <div class="section-heading">

        <div class="section-kicker">
            Creator
        </div>

        <h2 class="section-title">
            About Tisay AI
        </h2>

    </div>


    <div class="about-card">

        <h3>
            AICG × Textgen × Interactive Design
        </h3>

        <p>
            Tisay AI creates original characters, visual identities,
            interactive roleplay experiences and fictional worlds.
            Character cards combine original concepts, storytelling,
            AI-assisted creative workflows and collectible-inspired
            presentation.
        </p>

        <div class="creator-links">

            <a
                href="https://tisayai.com"
                target="_blank"
                rel="noopener"
                class="creator-link"
            >
                Website
            </a>

            <a
                href="https://ko-fi.com/tisay"
                target="_blank"
                rel="noopener"
                class="creator-link"
            >
                Ko-fi
            </a>

        </div>

    </div>

</section>

</main>


<!-- ======================================================
     CHARACTER MODAL
====================================================== -->

<div
    class="modal"
    id="characterModal"
    onclick="closeModalFromBackdrop(event)"
>

    <div class="modal-panel">

        <div class="modal-handle"></div>

        <button
            class="modal-close"
            onclick="closeCharacter()"
            aria-label="Close character"
        >
            ×
        </button>


        <div class="modal-image">

            <img
                id="modalImage"
                src=""
                alt=""
            >

        </div>


        <div class="modal-content">

            <div
                class="modal-world"
                id="modalWorld"
            ></div>

            <h2
                class="modal-name"
                id="modalName"
            ></h2>

            <div
                class="modal-title"
                id="modalTitle"
            ></div>

            <div
                class="modal-meta"
                id="modalMeta"
            ></div>

            <p
                class="modal-description"
                id="modalDescription"
            ></p>


            <div class="action-title">
                Character Files & Chat
            </div>

            <div
                class="platform-links"
                id="platformLinks"
            ></div>


            <div class="modal-actions">

                <button
                    class="secondary-action"
                    onclick="shareCurrentCharacter()"
                >
                    Share Card
                </button>

                <button
                    class="secondary-action"
                    onclick="copyCurrentCharacterLink()"
                >
                    Copy Link
                </button>

            </div>

        </div>

    </div>

</div>


<!-- ======================================================
     MOBILE NAVIGATION
====================================================== -->

<nav class="bottom-nav">

    <button
        class="nav-button active"
        onclick="goToSection('home', this)"
    >

        <span class="nav-icon">⌂</span>
        <span class="nav-label">Home</span>

    </button>


    <button
        class="nav-button"
        onclick="goToSection('characters', this)"
    >

        <span class="nav-icon">♢</span>
        <span class="nav-label">Cards</span>

    </button>


    <button
        class="nav-button"
        onclick="goToSection('discover', this)"
    >

        <span class="nav-icon">𒌐</span>
        <span class="nav-label">Summon</span>

    </button>


    <button
        class="nav-button"
        onclick="goToSection('about', this)"
    >

        <span class="nav-icon">✦</span>
        <span class="nav-label">Tisay</span>

    </button>

</nav>


<script>

/* =========================================================
   ★★★★★ EDIT YOUR CHARACTERS HERE ★★★★★

   THIS IS THE ONLY AREA YOU NORMALLY NEED TO EDIT.

   COPY A CHARACTER BLOCK.
   PASTE IT UNDER THE PREVIOUS ONE.
   CHANGE THE INFORMATION.
   DONE.

========================================================= */


const CHARACTERS = [


/* =========================================================
   CHARACTER EXAMPLE #1
========================================================= */

{
    id: "example-character",

    name: "Character Name",

    title: "The Crimson Prince",

    /* ImgChest DIRECT IMAGE URL */
    image:
        "https://cdn.imgchest.com/files/your-image.png",

    /* Optional larger/alternate image.
       Leave blank to use image above. */
    profileImage: "",

    world: "The Continent",

    species: "Monsterkin",

    role: "Royal Knight",

    gender: "Male",

    description:
        "Replace this with the character's short introduction or lore. This is what visitors will read when they open the character card.",

    tags: [
        "Fantasy",
        "Romance",
        "Monsterkin"
    ],

    /* Set true on ONE character */
    featured: true,


    /* =============================================
       DOWNLOADS

       Paste the direct PNG / JSON links here.

       Leave "" if you don't have one.
       Empty buttons automatically disappear.
    ============================================= */

    downloads: {

        png:
            "https://example.com/character.png",

        json:
            ""

    },


    /* =============================================
       CHAT PLATFORM LINKS

       Add, delete or rename platforms freely.

       Format:

       "BUTTON NAME": "URL"

       Empty links automatically disappear.
    ============================================= */

    links: {

        "Janitor AI":
            "",

        "Wyvern":
            "",

        "Saucepan":
            "",

        "Character AI":
            ""

    }

},


/* =========================================================
   CHARACTER EXAMPLE #2

   COPY THIS WHOLE BLOCK FOR NEW CHARACTERS.
========================================================= */

{
    id: "second-character",

    name: "Second Character",

    title: "Keeper of the Northern Gate",

    image:
        "https://cdn.imgchest.com/files/your-second-image.png",

    profileImage: "",

    world: "The Continent",

    species: "Demi-human",

    role: "Guardian",

    gender: "Male",

    description:
        "Another original character waiting somewhere beyond the northern mountains.",

    tags: [
        "Fantasy",
        "Demi-human",
        "Slow Burn"
    ],

    featured: false,

    downloads: {

        png: "",

        json: ""

    },

    links: {

        "Janitor AI": "",

        "Wyvern": "",

        "Saucepan": ""

    }

}


/* =========================================================
   ADD NEW CHARACTERS ABOVE THIS LINE.
========================================================= */

];


/* =========================================================
   OPTIONAL SITE SETTINGS
========================================================= */

const SITE = {

    /*
       Paste an ImgChest image URL here for your main banner.

       Leave blank and the website uses the featured
       character image automatically.
    */

    heroImage: ""

};


/* =========================================================
   EVERYTHING BELOW RUNS AUTOMATICALLY.
   YOU DO NOT NEED TO EDIT IT.
========================================================= */


let activeFilter = "All";

let currentCharacter = null;


/* -------------------------------
   IMAGE ERROR FALLBACK
-------------------------------- */

function imageFallback(img) {

    img.onerror = null;

    img.src =
        "data:image/svg+xml;charset=UTF-8," +
        encodeURIComponent(`
        <svg
            xmlns="http://www.w3.org/2000/svg"
            width="900"
            height="1200"
            viewBox="0 0 900 1200"
        >

            <rect
                width="100%"
                height="100%"
                fill="#141414"
            />

            <text
                x="50%"
                y="48%"
                text-anchor="middle"
                fill="#cbb99b"
                font-size="70"
                font-family="Georgia"
            >
                𒌐
            </text>

            <text
                x="50%"
                y="55%"
                text-anchor="middle"
                fill="#777"
                font-size="25"
                font-family="Arial"
                letter-spacing="8"
            >
                TISAY AI
            </text>

        </svg>
        `);

}


/* -------------------------------
   GET CHARACTER IMAGE
-------------------------------- */

function getCharacterImage(character) {

    return (
        character.profileImage ||
        character.image ||
        ""
    );

}


/* -------------------------------
   INITIALIZE SITE
-------------------------------- */

function init() {

    updateStats();

    createFilters();

    renderCharacters();

    renderFeatured();

    setupHero();

    openCharacterFromURL();

}


/* -------------------------------
   STATS
-------------------------------- */

function updateStats() {

    document.getElementById("characterCount").textContent =
        CHARACTERS.length;

    const worlds =
        new Set(
            CHARACTERS
                .map(character => character.world)
                .filter(Boolean)
        );

    document.getElementById("worldCount").textContent =
        worlds.size;

}


/* -------------------------------
   HERO
-------------------------------- */

function setupHero() {

    const hero =
        document.getElementById("heroBackground");

    const featured =
        CHARACTERS.find(character => character.featured)
        || CHARACTERS[0];

    const image =
        SITE.heroImage ||
        (featured ? getCharacterImage(featured) : "");

    if (!image) return;


    hero.innerHTML = `

        <img
            src="${escapeHTML(image)}"
            alt="Tisay AI"
            onerror="imageFallback(this)"
        >

    `;

}


/* -------------------------------
   FILTERS
-------------------------------- */

function createFilters() {

    const container =
        document.getElementById("filters");


    const worlds =
        [
            "All",
            ...new Set(
                CHARACTERS
                    .map(character => character.world)
                    .filter(Boolean)
            )
        ];


    container.innerHTML =
        worlds
            .map(world => `

                <button
                    class="filter-btn ${world === "All" ? "active" : ""}"
                    onclick="setFilter('${escapeAttribute(world)}', this)"
                >

                    ${escapeHTML(world)}

                </button>

            `)
            .join("");

}


/* -------------------------------
   SET FILTER
-------------------------------- */

function setFilter(filter, button) {

    activeFilter = filter;


    document
        .querySelectorAll(".filter-btn")
        .forEach(btn =>
            btn.classList.remove("active")
        );


    button.classList.add("active");


    renderCharacters();

}


/* -------------------------------
   SEARCH
-------------------------------- */

document
    .getElementById("characterSearch")
    .addEventListener(
        "input",
        renderCharacters
    );


/* -------------------------------
   RENDER CHARACTERS
-------------------------------- */

function renderCharacters() {

    const grid =
        document.getElementById("characterGrid");

    const empty =
        document.getElementById("emptyState");

    const search =
        document
            .getElementById("characterSearch")
            .value
            .toLowerCase()
            .trim();


    const results =
        CHARACTERS.filter(character => {

            const matchesFilter =
                activeFilter === "All" ||
                character.world === activeFilter;


            const searchable =
                [
                    character.name,
                    character.title,
                    character.world,
                    character.species,
                    character.role,
                    character.gender,
                    ...(character.tags || [])
                ]
                .join(" ")
                .toLowerCase();


            const matchesSearch =
                !search ||
                searchable.includes(search);


            return (
                matchesFilter &&
                matchesSearch
            );

        });


    if (!results.length) {

        grid.innerHTML = "";

        empty.style.display = "block";

        return;

    }


    empty.style.display = "none";


    grid.innerHTML =
        results
            .map(createCharacterCard)
            .join("");

}


/* -------------------------------
   CREATE CHARACTER CARD
-------------------------------- */

function createCharacterCard(character) {

    const tags =
        (character.tags || [])
            .slice(0, 2)
            .map(tag => `

                <span class="tag">
                    ${escapeHTML(tag)}
                </span>

            `)
            .join("");


    return `

        <article
            class="character-card"
            onclick="openCharacter('${escapeAttribute(character.id)}')"
        >

            <div class="card-image">

                <img
                    src="${escapeHTML(character.image)}"
                    alt="${escapeHTML(character.name)}"
                    loading="lazy"
                    decoding="async"
                    onerror="imageFallback(this)"
                >

                <span class="card-world">
                    ${escapeHTML(character.world || "Original Character")}
                </span>

            </div>


            <div class="card-content">

                <h3 class="card-name">
                    ${escapeHTML(character.name)}
                </h3>

                <div class="card-subtitle">

                    ${escapeHTML(
                        character.title ||
                        character.role ||
                        ""
                    )}

                </div>


                <div class="card-tags">

                    ${tags}

                </div>

            </div>

        </article>

    `;

}


/* -------------------------------
   FEATURED CHARACTER
-------------------------------- */

function renderFeatured() {

    const container =
        document.getElementById("featuredCharacter");


    const character =
        CHARACTERS.find(
            character => character.featured
        ) ||
        CHARACTERS[0];


    if (!character) {

        document
            .getElementById("featuredSection")
            .style.display = "none";

        return;

    }


    container.innerHTML = `

        <div
            class="featured"
            onclick="openCharacter('${escapeAttribute(character.id)}')"
            style="cursor:pointer;"
        >

            <div class="featured-image">

                <span class="featured-badge">
                    Featured Character
                </span>

                <img
                    src="${escapeHTML(character.image)}"
                    alt="${escapeHTML(character.name)}"
                    loading="lazy"
                    onerror="imageFallback(this)"
                >

            </div>


            <div class="featured-info">

                <h3 class="featured-name">
                    ${escapeHTML(character.name)}
                </h3>

                <div class="featured-title">
                    ${escapeHTML(character.title || "")}
                </div>

                <p class="featured-desc">
                    ${escapeHTML(character.description || "")}
                </p>

            </div>

        </div>

    `;

}


/* -------------------------------
   OPEN CHARACTER
-------------------------------- */

function openCharacter(id, updateURL = true) {

    const character =
        CHARACTERS.find(
            character => character.id === id
        );


    if (!character) return;


    currentCharacter =
        character;


    document.getElementById("modalImage").src =
        getCharacterImage(character);


    document.getElementById("modalImage").alt =
        character.name;


    document.getElementById("modalImage").onerror =
        function() {
            imageFallback(this);
        };


    document.getElementById("modalWorld").textContent =
        character.world ||
        "Tisay AI";


    document.getElementById("modalName").textContent =
        character.name;


    document.getElementById("modalTitle").textContent =
        character.title ||
        "";


    const metadata =
        [
            character.species,
            character.role,
            character.gender,
            ...(character.tags || [])
        ]
        .filter(Boolean);


    document.getElementById("modalMeta").innerHTML =
        metadata
            .map(item => `

                <span class="meta-pill">
                    ${escapeHTML(item)}
                </span>

            `)
            .join("");


    document.getElementById("modalDescription").textContent =
        character.description ||
        "";


    renderCharacterLinks(character);


    document
        .getElementById("characterModal")
        .classList
        .add("open");


    document.body.classList.add("modal-open");


    if (updateURL) {

        const url =
            new URL(window.location.href);

        url.searchParams.set(
            "character",
            character.id
        );

        history.replaceState(
            {},
            "",
            url
        );

    }

}


/* -------------------------------
   CHARACTER LINKS
-------------------------------- */

function renderCharacterLinks(character) {

    const container =
        document.getElementById("platformLinks");


    const buttons = [];


    /* PNG DOWNLOAD */

    if (
        character.downloads &&
        character.downloads.png
    ) {

        buttons.push(`

            <a
                href="${escapeHTML(character.downloads.png)}"
                target="_blank"
                rel="noopener"
                class="platform-link primary"
            >

                ↓ Download Character PNG

            </a>

        `);

    }


    /* JSON DOWNLOAD */

    if (
        character.downloads &&
        character.downloads.json
    ) {

        buttons.push(`

            <a
                href="${escapeHTML(character.downloads.json)}"
                target="_blank"
                rel="noopener"
                class="platform-link"
            >

                ↓ JSON

            </a>

        `);

    }


    /* CHAT PLATFORMS */

    if (character.links) {

        Object.entries(character.links)
            .forEach(([name, url]) => {

                if (!url) return;


                buttons.push(`

                    <a
                        href="${escapeHTML(url)}"
                        target="_blank"
                        rel="noopener"
                        class="platform-link"
                    >

                        ${escapeHTML(name)} ↗

                    </a>

                `);

            });

    }


    if (!buttons.length) {

        container.innerHTML = `

            <div
                style="
                    grid-column:1/-1;
                    color:var(--muted);
                    font-size:.78rem;
                    padding:15px 0;
                "
            >
                This character isn't currently available
                for download or chat.
            </div>

        `;

        return;

    }


    container.innerHTML =
        buttons.join("");

}


/* -------------------------------
   CLOSE CHARACTER
-------------------------------- */

function closeCharacter() {

    document
        .getElementById("characterModal")
        .classList
        .remove("open");


    document.body.classList.remove("modal-open");


    currentCharacter =
        null;


    const url =
        new URL(window.location.href);


    url.searchParams.delete(
        "character"
    );


    history.replaceState(
        {},
        "",
        url
    );

}


/* -------------------------------
   CLOSE BACKDROP
-------------------------------- */

function closeModalFromBackdrop(event) {

    if (
        event.target.id ===
        "characterModal"
    ) {

        closeCharacter();

    }

}


/* -------------------------------
   OPEN FROM URL
-------------------------------- */

function openCharacterFromURL() {

    const params =
        new URLSearchParams(
            window.location.search
        );


    const id =
        params.get("character");


    if (id) {

        openCharacter(
            id,
            false
        );

    }

}


/* -------------------------------
   RANDOM CHARACTER
-------------------------------- */

function summonRandomCharacter() {

    if (!CHARACTERS.length)
        return;


    const random =
        CHARACTERS[
            Math.floor(
                Math.random() *
                CHARACTERS.length
            )
        ];


    openCharacter(
        random.id
    );

}


/* -------------------------------
   SHARE CHARACTER
-------------------------------- */

async function shareCurrentCharacter() {

    if (!currentCharacter)
        return;


    const url =
        createCharacterURL(
            currentCharacter.id
        );


    if (navigator.share) {

        try {

            await navigator.share({

                title:
                    currentCharacter.name +
                    " — Tisay AI",

                text:
                    currentCharacter.title ||
                    "Original character by Tisay AI",

                url: url

            });

            return;

        }

        catch (error) {}

    }


    await copyText(url);

}


/* -------------------------------
   COPY CHARACTER LINK
-------------------------------- */

async function copyCurrentCharacterLink() {

    if (!currentCharacter)
        return;


    const url =
        createCharacterURL(
            currentCharacter.id
        );


    await copyText(url);

}


/* -------------------------------
   CREATE SHARE URL
-------------------------------- */

function createCharacterURL(id) {

    const url =
        new URL(
            window.location.href
        );


    url.searchParams.set(
        "character",
        id
    );


    return url.toString();

}


/* -------------------------------
   COPY TEXT
-------------------------------- */

async function copyText(text) {

    try {

        await navigator.clipboard.writeText(
            text
        );


        alert(
            "Character link copied!"
        );

    }

    catch (error) {

        prompt(
            "Copy this link:",
            text
        );

    }

}


/* -------------------------------
   NAVIGATION
-------------------------------- */

function goToSection(id, button) {

    document
        .getElementById(id)
        .scrollIntoView({
            behavior: "smooth"
        });


    document
        .querySelectorAll(".nav-button")
        .forEach(btn =>
            btn.classList.remove("active")
        );


    button.classList.add("active");

}


/* -------------------------------
   ESCAPE HTML
-------------------------------- */

function escapeHTML(value) {

    if (
        value === null ||
        value === undefined
    )
        return "";


    return String(value)

        .replaceAll(
            "&",
            "&amp;"
        )

        .replaceAll(
            "<",
            "&lt;"
        )

        .replaceAll(
            ">",
            "&gt;"
        )

        .replaceAll(
            '"',
            "&quot;"
        )

        .replaceAll(
            "'",
            "&#039;"
        );

}


/* -------------------------------
   ESCAPE ATTRIBUTE
-------------------------------- */

function escapeAttribute(value) {

    return escapeHTML(value)
        .replaceAll(
            "\\",
            "\\\\"
        );

}


/* -------------------------------
   ESC KEY
-------------------------------- */

document.addEventListener(
    "keydown",
    event => {

        if (
            event.key === "Escape"
        ) {

            closeCharacter();

        }

    }
);


/* -------------------------------
   START
-------------------------------- */

init();

</script>

</body>
